{
  "name": "document-media-extractor",
  "version": "0.1.0",
  "description": "Local-first extraction of embedded media from document and ZIP containers.",
  "keywords": [
    "docx",
    "pptx",
    "xlsx",
    "ooxml",
    "opendocument",
    "epub",
    "cbz",
    "zip",
    "media-extraction",
    "local-first"
  ],
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WanderZil/document-media-extractor.git"
  },
  "bugs": {
    "url": "https://github.com/WanderZil/document-media-extractor/issues"
  },
  "homepage": "https://github.com/WanderZil/document-media-extractor#readme",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm review:build && tsc -p tsconfig.build.json",
    "fixtures": "tsx scripts/build-fixtures.ts",
    "review:build": "esbuild review/app.js --bundle --format=iife --minify --outfile=review/app.bundle.js && perl -pi -e 's/[ \\t]+$//' review/app.bundle.js",
    "test": "tsx --test",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "document-media-extractor": "dist/cli.js"
  },
  "files": [
    "dist",
    "review",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
